# URL del proyecto de Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clave pública (publishable / anon). Es segura en el navegador: el acceso real lo controla RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# URL pública de la app (se usa en los enlaces de los correos y en el sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
